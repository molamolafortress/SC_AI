+
+        // ---- intel brief: scouting intelligence organised for the Strategy LLM (StateSummary.intel) --------------
+        // Cheap: called only when a state is emitted (every `every` frames or on events). Everything here is already
+        // computed by McRave (Spy timings, Stations, Scouts, Grids); this only collects and names it.
+        struct BuildingIntel {
+            int count = 0, firstSeen = -1, started = -1, completes = -1;
+        };
+        map<string, BuildingIntel> buildingIntel; // merged across frames so destroyed/forgotten buildings keep their timings
+        struct BuildingPos {
+            TilePosition tile = TilePositions::Invalid;
+            double progress = 0.0;
+            int completes = -1, lastSeen = -1;
+            bool completed = false;
+        };
+        map<Unit, BuildingPos> buildingPos;
+        struct EnemyBase {
+            int workersMax = 0, hatcheries = 0, lastSeen = -1;
+            string region; // named region at first sight, kept after the station is lost (enemy_main stays enemy_main)
+        };
+        map<const BWEB::Station *, EnemyBase> enemyBases;
+        int mainScoutedFrame = -1, natScoutedFrame = -1, gasFirstSeen = -1, armyFirstSeen = -1, workersSeenMax = 0;
+
+        string timeStr(int frame) { return frame < 0 ? string("?") : Time(frame).toString(); }
+
+        string stratState(const string &name, Time likelyTime)
+        {
+            if (name.empty() || name == "Unknown") return "unknown";
+            return likelyTime.isUnknown() ? "possible" : "likely";
+        }
+
+        bool isWorkerName(const string &n) { return n == "drone" || n == "scv" || n == "probe"; }
+        bool isGasName(const string &n) { return n == "extractor" || n == "refinery" || n == "assimilator"; }
+        bool isNonArmyName(const string &n)
+        {
+            return isWorkerName(n) || n == "overlord" || n == "larva" || n == "egg" || n == "lurker_egg" || n == "cocoon" || n == "broodling" || n == "scarab" ||
+                   n == "interceptor" || n == "spider_mine" || n == "nuclear_missile";
+        }
+
+        void fillIntel()
+        {
+            const int frame = Broodwar->getFrameCount();
+            nlohmann::json j = nlohmann::json::object();
+
+            // 1. McRave Spy's enemy build inference (names from Strategy/Spy/Defs.h) and its "likely" strategy flags.
+            j["enemy_build"]            = Spy::getEnemyBuild();
+            j["enemy_opener"]           = Spy::getEnemyOpener();
+            j["enemy_transition"]       = Spy::getEnemyTransition();
+            j["enemy_build_state"]      = stratState(Spy::getEnemyBuild(), Spy::getEnemyBuildTime());
+            j["enemy_opener_state"]     = stratState(Spy::getEnemyOpener(), Spy::getEnemyOpenerTime());
+            j["enemy_transition_state"] = stratState(Spy::getEnemyTransition(), Spy::getEnemyTransitionTime());
+            // Spy's strategy flags (Strat::likely). The *Time() accessors are declared but not defined upstream, so flags only.
+            nlohmann::json flags = nlohmann::json::array();
+            auto flag = [&](const char *k, bool on) { if (on) flags.push_back(k); };
+            flag("expand", Spy::enemyFastExpand());
+            flag("rush", Spy::enemyRush());
+            flag("proxy", Spy::enemyProxy());
+            flag("possible_proxy", Spy::enemyPossibleProxy());
+            flag("gas_steal", Spy::enemyGasSteal());
+            flag("pressure", Spy::enemyPressure());
+            flag("wall", Spy::enemyWalled());
+            flag("greedy", Spy::enemyGreedy());
+            flag("invis", Spy::enemyInvis());
+            flag("detection", Spy::enemyDetection());
+            flag("turtle", Spy::enemyTurtle());
+            flag("fortress", Spy::enemyFortress());
+            j["flags"] = flags;
+            nlohmann::json mirror = nlohmann::json::object();
+            if (Players::ZvZ()) {
+                mirror["pool"]  = Spy::Zerg::enemyFasterPool() ? "faster_than_ours" : Spy::Zerg::enemySlowerPool() ? "slower_than_ours" : Spy::Zerg::enemyEqualPool() ? "equal" : "unknown";
+                mirror["speed"] = Spy::Zerg::enemyFasterSpeed() ? "faster_than_ours" : Spy::Zerg::enemySlowerSpeed() ? "slower_than_ours" : "unknown";
+            }
+            if (Players::vT()) mirror["terran_style"] = Spy::Terran::enemyMech() ? "mech" : Spy::Terran::enemyBio() ? "bio" : "unknown";
+            j["mirror"]          = mirror;
+            j["workers_pulled"]  = Spy::getWorkersPulled();
+
+            // 2. Enemy buildings: first-seen frame (tracker) + estimated start/complete frame (UnitInfo health-based estimate,
+            //    the same numbers Spy logs as "starts at"/"completes at").
+            for (auto &[name, b] : tracker->buildingsSeen()) {
+                auto &bi = buildingIntel[name];
+                bi.count = max(bi.count, b.count);
+                if (bi.firstSeen < 0) bi.firstSeen = b.firstFrame;
+            }
+            for (auto &u : Units::getUnits(PlayerState::Enemy)) {
+                auto &unit = *u;
+                if (!unit.getType().isBuilding())
+                    continue;
+                string n = unit.getType().getName();
+                auto us = n.find('_');
+                if (us != string::npos) n = n.substr(us + 1);
+                n = norm(n);
+                auto &bi = buildingIntel[n];
+                if (unit.frameStartedWhen() > 0 && (bi.started < 0 || unit.frameStartedWhen() < bi.started)) bi.started = unit.frameStartedWhen();
+                if (unit.frameCompletesWhen() > 0 && (bi.completes < 0 || unit.frameCompletesWhen() < bi.completes)) bi.completes = unit.frameCompletesWhen();
+                if (bi.firstSeen < 0) bi.firstSeen = frame;
+            }
+            // Per-building positions (item A): region name, tile, progress (BWAPI remaining build time while visible, else the
+            // last value / McRave's health-based estimate), completion time, last seen. Keyed by BWAPI unit so unseen buildings keep their last state.
+            map<string, nlohmann::json> positions;
+            for (auto &u : Units::getUnits(PlayerState::Enemy)) {
+                auto &unit = *u;
+                if (!unit.getType().isBuilding() || !unit.unit())
+                    continue;
+                auto &bp = buildingPos[unit.unit()];
+                bp.tile  = unit.getTilePosition();
+                if (unit.unit()->exists()) {
+                    auto bt      = unit.getType().buildTime();
+                    bp.completed = unit.unit()->isCompleted();
+                    bp.progress  = bp.completed ? 1.0 : (bt > 0 ? max(0.0, 1.0 - double(unit.unit()->getRemainingBuildTime()) / bt) : 0.0);
+                    bp.completes = bp.completed ? -1 : frame + unit.unit()->getRemainingBuildTime();
+                    bp.lastSeen  = frame;
+                }
+                else {
+                    bp.lastSeen = max(bp.lastSeen, unit.getLastVisibleFrame());
+                    if (!bp.completed) {
+                        if (bp.completes < 0 && unit.frameCompletesWhen() > 0) bp.completes = unit.frameCompletesWhen();
+                        if (bp.completes >= 0 && frame >= bp.completes) { bp.completed = true; bp.progress = 1.0; bp.completes = -1; }
+                        else if (bp.completes >= 0 && unit.frameStartedWhen() > 0 && bp.completes > unit.frameStartedWhen())
+                            bp.progress = max(bp.progress, min(1.0, double(frame - unit.frameStartedWhen()) / (bp.completes - unit.frameStartedWhen())));
+                    }
+                }
+                positions[typeName(unit.getType())].push_back({{"region", regionName(unit.getPosition())}, {"tile", {bp.tile.x, bp.tile.y}}, {"progress", bp.progress},
+                                                               {"completes_time", timeStr(bp.completes)},   // "?" once completed / unknown (schema: str)
+                                                               {"last_seen_time", timeStr(bp.lastSeen)}});
+            }
+            nlohmann::json buildings = nlohmann::json::object();
+            int gasCount = 0;
+            for (auto &[name, bi] : buildingIntel) {
+                buildings[name] = {{"count", bi.count}, {"first_seen_frame", bi.firstSeen}, {"started_frame", bi.started}, {"started_time", timeStr(bi.started)},
+                                   {"completes_frame", bi.completes}, {"completes_time", timeStr(bi.completes)},
+                                   {"positions", positions.count(name) ? positions[name] : nlohmann::json::array()}};
+                if (isGasName(name)) {
+                    gasCount += bi.count;
+                    if (gasFirstSeen < 0 && bi.count > 0) gasFirstSeen = bi.firstSeen;
+                }
+            }
+            j["buildings"] = buildings;
+
+            // Enemy bases (item A): McRave's enemy stations; workers counted by proximity (10 tiles) while visible, max kept.
+            for (auto s : Stations::getStations(PlayerState::Enemy)) {
+                auto &eb    = enemyBases[s];
+                eb.lastSeen = max(eb.lastSeen, Stations::lastVisible(s));
+                if (eb.region.empty() || eb.region.rfind("unknown", 0) == 0) eb.region = regionName(s->getBase()->Center());
+                int workers = 0, hatch = 0;
+                for (auto u : Broodwar->enemy()->getUnits())
+                    if (u->exists() && u->getType().isWorker() && u->getPosition().getDistance(s->getBase()->Center()) <= 10 * 32) workers++;
+                for (auto &u : Units::getUnits(PlayerState::Enemy))
+                    if (u->getType().isResourceDepot() && u->getPosition().getDistance(s->getBase()->Center()) <= 10 * 32) hatch++;
+                eb.workersMax = max(eb.workersMax, workers);
+                eb.hatcheries = hatch;
+            }
+            nlohmann::json ebJ = nlohmann::json::array();
+            for (auto &[s, eb] : enemyBases)
+                ebJ.push_back({{"region", eb.region}, {"workers_seen_max", eb.workersMax}, {"last_seen_time", timeStr(eb.lastSeen)},
+                               {"hatcheries", eb.hatcheries}, {"owner", ownerOf(s)}});
+            j["enemy_bases"] = ebJ;
+
+            // 3. Workers, gas, expansions.
+            int workers = 0;
+            for (auto &[name, su] : tracker->unitsSeen())
+                if (isWorkerName(name)) workers = max(workers, su.count);
+            workersSeenMax = max(workersSeenMax, workers);
+            j["workers_seen_max"] = workersSeenMax;
+            j["gas"] = {{"count", gasCount}, {"first_seen_frame", gasFirstSeen}, {"first_seen_time", timeStr(gasFirstSeen)}};
+            j["expansions"] = max(int(Stations::getStations(PlayerState::Enemy).size()), tracker->expansionsSeen());
+
+            // 4. Scouting status: when our scout reached the enemy main/natural and when they were last visible.
+            auto enemyMain = Terrain::getEnemyMain();
+            auto enemyNat  = Terrain::getEnemyNatural();
+            if (enemyMain && mainScoutedFrame < 0 && Stations::isBaseExplored(enemyMain)) mainScoutedFrame = frame;
+            if (enemyNat && natScoutedFrame < 0 && Stations::isBaseExplored(enemyNat)) natScoutedFrame = frame;
+            j["scout"] = {{"enemy_main_found", Terrain::foundEnemy()},
+                          {"main_scouted_frame", mainScoutedFrame}, {"main_scouted_time", timeStr(mainScoutedFrame)},
+                          {"natural_scouted_frame", natScoutedFrame}, {"natural_scouted_time", timeStr(natScoutedFrame)},
+                          {"full_scout", Scouts::gotFullScout()}, {"scout_denied", Scouts::enemyDeniedScout()},
+                          {"main_last_seen_frame", enemyMain ? Stations::lastVisible(enemyMain) : -1},
+                          {"natural_last_seen_frame", enemyNat ? Stations::lastVisible(enemyNat) : -1}};
+
+            // 5. Enemy army: max seen count per type, first sighting.
+            nlohmann::json army = nlohmann::json::object();
+            for (auto &[name, su] : tracker->unitsSeen()) {
+                if (isNonArmyName(name) || su.count <= 0)
+                    continue;
+                army[name] = su.count;
+                if (su.firstFrame >= 0 && (armyFirstSeen < 0 || su.firstFrame < armyFirstSeen)) armyFirstSeen = su.firstFrame;
+            }
+            j["army"] = {{"first_seen_frame", armyFirstSeen}, {"first_seen_time", timeStr(armyFirstSeen)}, {"max_by_type", army}};
+            tracker->intel = j;
+        }
+
+        void meterCommands()
+        {
+            const int frame = Broodwar->getFrameCount();
+            if (frame == lastMeteredFrame)
+                return;
+            lastMeteredFrame  = frame;
+            commandsThisFrame = 0;
+            for (auto u : Broodwar->self()->getUnits()) {
+                if (u->exists() && u->getLastCommandFrame() == frame)
+                    commandsThisFrame++;
+            }
+            commandsTotal += commandsThisFrame;
+            auto &slot = commandRing[frame % commandRing.size()];
+            commandRingSum += commandsThisFrame - slot;
+            slot = commandsThisFrame;
+
+            nlohmann::json m = nlohmann::json::object();
+            m["commands_this_frame"] = commandsThisFrame;
+            m["commands_total"]      = commandsTotal;
+            m["apm_60s"]             = frame >= int(commandRing.size()) ? double(commandRingSum) : (frame > 0 ? double(commandRingSum) * 1440.0 / frame : 0.0);
+            m["apm_game"]            = frame > 0 ? double(commandsTotal) * 1440.0 / frame : 0.0;
+            tracker->metrics = m;
+        }
+
+        void drawStatus()
+        {
+            if (!client)
+                return;
+            auto status = client->connected() ? "ok" : "down";
+            if (current)
+                Broodwar->drawTextScreen(432, 46, "%csidecar[%s] %s %s/%s exp %d", Text::Green, status, current->directive_id.c_str(), current->stance.c_str(),
+                                         current->expand_policy.c_str(), current->expires_frame);
+            else
+                Broodwar->drawTextScreen(432, 46, "%csidecar[%s] no directive (posts %d/%d)", Text::Grey, status, client->postsSent(), client->postsFailed());
+        }
+    } // namespace
+
+    bool enabled() { return started && config.enabled && client != nullptr; }
+
+    // ---- hook 2 ------------------------------------------------------------------------------------------------
+    void onStart()
+    {
+        config  = readConfig();
+        started = true;
+        if (!config.enabled)
+            return;
+        tracker = make_unique<StateTracker>();
+        if (const char* v = std::getenv("SC_AI_LOCKSTEP"); v && *v && *v != '0')
+            config.timeoutMs = max(config.timeoutMs, 180000);   // the sidecar may run the LLM inside the request
+        client  = make_unique<SidecarClient>(config.host, config.port, config.every, config.timeoutMs);
+        LOG("Sidecar: enabled, ", config.host, ":", config.port, " every ", config.every, " frames, game_id ", client->gameId());
+    }
+
+    void onFrame()
+    {
+        const int frame = Broodwar->getFrameCount();
+        // Frame cap (eval harness): SC_AI_MAX_FRAMES. Leaving counts as a timeout, not a win.
+        static int maxFrames = [] { const char* v = std::getenv("SC_AI_MAX_FRAMES"); return v ? std::atoi(v) : 0; }();
+        if (maxFrames > 0 && frame >= maxFrames && !timedOut) {
+            timedOut = true;
+            LOG("Sidecar: frame cap ", maxFrames, " reached, leaving game");
+            Broodwar->leaveGame();
+            return;
+        }
+        if (!enabled())
+            return;
+        current = client->directive();
+        if (current && !current->valid(frame))
+            current.reset();
+        {
+            const string id = (current && !current->observe_only) ? current->directive_id : "";
+            if (id != overridesForId) {
+                overridesForId = id;
+                overrides.clear();   // statuses belong to one directive id; overrideLogged is kept so a repeated identical status is not re-logged
+                directiveStartDrones = -1;
+            }
+        }
+        if (current && current->directive_id != lastLoggedId) {
+            lastLoggedId = current->directive_id;
+            LOG("Sidecar: directive ", current->directive_id, " opening=", current->opening, " stance=", current->stance, " expand=", current->expand_policy,
+                " objective=", current->objective_type, "@", current->objective_location, " wall=", current->wall_natural, " expires=", current->expires_frame, " reason=", current->change_reason);
+        }
+    }
+
+    static string gameTimeString(int frame)
+    {
+        const int secs = frame * 42 / 1000;
+        char buf[16]; std::snprintf(buf, sizeof buf, "%d:%02d", secs / 60, secs % 60);
+        return buf;
+    }
+
+    void writeUnitSnapshot(const string &path)
+    {
+        static std::ofstream out;
+        if (!out.is_open()) out.open(path, std::ios::app);
+        if (!out) return;
+        const int frame = Broodwar->getFrameCount();
+        nlohmann::json units = nlohmann::json::array();
+        auto add = [&](BWAPI::Unit u, const char *side) {
+            if (!u || !u->exists()) return;
+            nlohmann::json j = {
+                {"id", u->getID()}, {"side", side}, {"type", u->getType().getName()},
+                {"x", u->getPosition().x}, {"y", u->getPosition().y},
+                {"hp", u->getHitPoints()}, {"sh", u->getShields()}, {"en", u->getEnergy()},
+                {"order", u->getOrder().getName()},
+            };
+            if (u->getTarget()) j["target"] = u->getTarget()->getID();
+            else if (u->getOrderTarget()) j["target"] = u->getOrderTarget()->getID();
+            if (u->getType().isBuilding() && !u->isCompleted()) j["build_left"] = u->getRemainingBuildTime();
+            if (u->isCloaked() || u->isBurrowed()) j["cloaked"] = true;
+            if (u->getType().isWorker() && u->isGatheringMinerals()) j["mining"] = true;
+            units.push_back(std::move(j));
+        };
+        for (auto u : Broodwar->self()->getUnits()) add(u, "me");
+        for (auto u : Broodwar->enemy()->getUnits()) add(u, "enemy");
+        nlohmann::json line = {{"frame", frame}, {"t", gameTimeString(frame)}, {"minerals", Broodwar->self()->minerals()},
+                               {"gas", Broodwar->self()->gas()}, {"supply", {Broodwar->self()->supplyUsed() / 2, Broodwar->self()->supplyTotal() / 2}},
+                               {"units", units}};
+        out << line.dump() << '\n';
+        if (frame % 240 == 0) out.flush();
+    }
+
+    void emitIfDue()
+    {
+        // Item E: SC_AI_MAP_DUMP=<path>: dump BWEM/BWEB map knowledge on the first frame (all managers initialised) and leave.
+        static const string mapDumpPath = [] { const char *v = std::getenv("SC_AI_MAP_DUMP"); return v ? string(v) : string(); }();
+        static bool mapDumped = false;
+        if (!mapDumpPath.empty() && !mapDumped) {
+            mapDumped = true;
+            buildRegions();
+            writeMapDump(mapDumpPath);
+            Broodwar->leaveGame();
+            return;
+        }
+        // Unit snapshots (SC_AI_UNIT_SNAPSHOTS=<file>): every 24 frames, one JSON line with every own unit and every
+        // visible enemy unit (id, type, player, tile/pixel pos, hp, shields, energy, order, target). Offline/training data;
+        // never sent to the LLM in-game. Independent of the sidecar being enabled.
+        static const string snapPath = [] { const char *v = std::getenv("SC_AI_UNIT_SNAPSHOTS"); return v ? string(v) : string(); }();
+        if (!snapPath.empty() && Broodwar->getFrameCount() % 24 == 0)
+            writeUnitSnapshot(snapPath);
+        if (!enabled())
+            return;
+        meterCommands();
+        if (!tracker->regionNamer)
+            tracker->regionNamer = [](Position p) { return regionName(p); };
+        tracker->update();
+        updateEngagement();
+        if (Broodwar->getFrameCount() % config.every == 0 || tracker->hasPendingEvents()) {
+            buildRegions();
+            tracker->regions = regionsJson();
+            fillCombatSim();
+            fillBodyDefaults();
+            fillIntel();
+            fillMyBases();
+            fillExecution();
+        }
+        client->onFrame(*tracker);
+        // Lockstep (SC_AI_LOCKSTEP=1): the game waits while a state post (and, with the sidecar in lockstep mode,
+        // the LLM call it triggers) is in flight. LAN opponents wait too, so decisions land on the frame they were asked for.
+        static bool lockstep = [] { const char* v = std::getenv("SC_AI_LOCKSTEP"); return v && *v && *v != '0'; }();
+        if (lockstep && client->busy() && !client->waitIdle(180000))
+            LOG("Sidecar: lockstep wait timed out at frame ", Broodwar->getFrameCount());
+        drawStatus();
+    }
+
+    void onUnitDiscover(Unit unit)
+    {
+        // Enemy buildings are detected by StateTracker::update() (first-seen events); nothing extra is needed here.
+        (void)unit;
+    }
+
+    void onUnitDestroy(Unit unit)
+    {
+        if (!enabled() || !unit)
+            return;
+        tracker->onUnitDestroy(unit);
+        if (unit->getPlayer() == Broodwar->self() && unit->getType().isBuilding())
+            tracker->pushEvent("my_building_lost", unit->getType().getName());
+        // Item C: loss window for engagement detection (resource value; larva/eggs/broodlings are free and skipped)
+        const bool mine = unit->getPlayer() == Broodwar->self(), theirs = unit->getPlayer() == Broodwar->enemy();
+        if ((mine || theirs) && unit->getType() != Zerg_Larva && unit->getType() != Zerg_Egg && unit->getType() != Zerg_Lurker_Egg && unit->getType() != Zerg_Cocoon) {
+            auto v = lossValue(unit->getType());
+            if (v > 0) {
+                Loss l{Broodwar->getFrameCount(), mine, v, typeName(unit->getType()), unit->getPosition()};
+                lossWindow.push_back(l);
+                if (inEngagement) addToEngagement(l);
+            }
+        }
+    }
+
+    void onEnd(bool isWinner)
+    {
+        if (!enabled())
+            return;
+        const std::string result = timedOut ? "timeout" : (isWinner ? "win" : "loss");
+        LOG("Sidecar: game end, ", result, ", posts ", client->postsSent(), " failed ", client->postsFailed(), ", commands ", commandsTotal);
+        client->onEnd(result);
+        client.reset();
+        tracker.reset();
+        current.reset();
+        buildingIntel.clear();
+        buildingPos.clear();
+        enemyBases.clear();
+        regions.clear();
+        overrides.clear();
+        overrideLogged.clear();
+        overridesForId.clear();
+        lossWindow.clear();
+        resetEngagement();
+        mainScoutedFrame = natScoutedFrame = gasFirstSeen = armyFirstSeen = -1;
+        workersSeenMax   = 0;
+    }
