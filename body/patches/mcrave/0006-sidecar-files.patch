+
+        // ---- item A: named regions ------------------------------------------------------------------------------
+        // Built on the first emit frame (Terrain/Stations/Walls are initialised after Sidecar::onStart) and refreshed on
+        // every emit (owner flags, enemy_* once scouted, third/fourth from McRave's expansion order). ~10 entries.
+        struct Region {
+            string name;
+            Position pos;
+            string owner;
+        };
+        vector<Region> regions;
+        const int regionRadius = 12 * 32; // px: nearest named region within this radius, else BWEM area fallback
+
+        string ownerOf(const BWEB::Station *s)
+        {
+            if (!s) return "none";
+            auto o = Stations::ownedBy(s);
+            return o == PlayerState::Self ? "me" : o == PlayerState::Enemy ? "enemy" : "none";
+        }
+
+        string typeName(UnitType t)
+        {
+            string n = t.getName();
+            auto us  = n.find('_');
+            if (us != string::npos && (n.rfind("Terran_", 0) == 0 || n.rfind("Zerg_", 0) == 0 || n.rfind("Protoss_", 0) == 0)) n = n.substr(us + 1);
+            return norm(n);
+        }
+
+        void buildRegions()
+        {
+            regions.clear();
+            auto add = [&](const string &name, Position p, const string &owner) {
+                if (p.isValid()) regions.push_back({name, p, owner});
+            };
+            auto myMain = Terrain::getMyMain(), myNat = Terrain::getMyNatural();
+            auto enMain = Terrain::getEnemyMain(), enNat = Terrain::getEnemyNatural();
+            if (myMain) add("main", myMain->getBase()->Center(), ownerOf(myMain));
+            if (myNat) add("natural", myNat->getBase()->Center(), ownerOf(myNat));
+
+            // third/fourth: McRave's expansion order (Expansion::onFrame; main and natural come first), fallback by ground distance from the natural
+            vector<const BWEB::Station *> extra;
+            for (auto s : Expansion::getExpandOrder())
+                if (s && s != myMain && s != myNat && s != enMain && s != enNat) extra.push_back(s);
+            if (extra.empty() && (myNat || myMain)) {
+                auto from = myNat ? myNat->getBase()->Center() : myMain->getBase()->Center();
+                vector<pair<double, const BWEB::Station *>> cand;
+                for (auto &s : BWEB::Stations::getStations()) {
+                    if (&s == myMain || &s == myNat || &s == enMain || &s == enNat || s.isMain()) continue;
+                    auto d = BWEB::Map::getGroundDistance(from, s.getBase()->Center());
+                    if (d < 1e9) cand.push_back({d, &s});
+                }
+                sort(cand.begin(), cand.end(), [](auto &a, auto &b) { return a.first < b.first; });
+                for (auto &[d, s] : cand) extra.push_back(s);
+            }
+            if (extra.size() > 0) add("third", extra[0]->getBase()->Center(), ownerOf(extra[0]));
+            if (extra.size() > 1) add("fourth", extra[1]->getBase()->Center(), ownerOf(extra[1]));
+
+            if (enMain) add("enemy_main", enMain->getBase()->Center(), ownerOf(enMain));
+            if (enNat) add("enemy_natural", enNat->getBase()->Center(), ownerOf(enNat));
+            for (auto s : Stations::getStations(PlayerState::Enemy)) {
+                if (s == enMain || s == enNat) continue;
+                add("enemy_third", s->getBase()->Center(), "enemy");
+                break;
+            }
+            add("center", Position(mapBWEM.Center()), "none");
+            if (myMain && enMain) {
+                int length = 0;
+                auto &path = mapBWEM.GetPath(myMain->getBase()->Center(), enMain->getBase()->Center(), &length);
+                if (!path.empty()) add("path_mid", Position(path[path.size() / 2]->Center()), "none");
+                else add("path_mid", (myMain->getBase()->Center() + enMain->getBase()->Center()) / 2, "none");
+            }
+        }
+
+        nlohmann::json regionsJson()
+        {
+            nlohmann::json j = nlohmann::json::object();
+            for (auto &r : regions) {
+                auto t    = TilePosition(r.pos);
+                j[r.name] = {{"tile", {t.x, t.y}}, {"owner", r.owner}};
+            }
+            return j;
+        }
+
+        string regionName(Position p)
+        {
+            if (!p.isValid()) return "unknown";
+            double best = DBL_MAX;
+            const Region *bestR = nullptr;
+            for (auto &r : regions) {
+                auto d = r.pos.getDistance(p);
+                if (d < best) { best = d; bestR = &r; }
+            }
+            if (bestR && best <= regionRadius) return bestR->name;
+            auto area = mapBWEM.GetNearestArea(WalkPosition(p));
+            return area ? "unknown_area_" + to_string(area->Id()) : "unknown";
+        }
+
+        // ---- item A: our bases, production ----------------------------------------------------------------------
+        const BWEB::Station *closestOwnStation(Position p)
+        {
+            const BWEB::Station *best = nullptr;
+            double bestD = DBL_MAX;
+            for (auto s : Stations::getStations(PlayerState::Self)) {
+                auto d = s->getBase()->Center().getDistance(p);
+                if (d < bestD) { bestD = d; best = s; }
+            }
+            return bestD <= 10 * 32 ? best : nullptr;
+        }
+
+        void fillMyBases()
+        {
+            nlohmann::json bases = nlohmann::json::array();
+            map<const BWEB::Station *, int> hatch;
+            for (auto u : Broodwar->self()->getUnits()) {
+                if (u->exists() && u->getType().isResourceDepot())
+                    if (auto s = closestOwnStation(u->getPosition())) hatch[s]++;
+            }
+            for (auto s : Stations::getStations(PlayerState::Self)) {
+                int wm = 0, wg = 0, patches = 0, geysers = 0;
+                for (auto &m : Resources::getMyMinerals())
+                    if (m->getStation() == s) { patches++; wm += m->getGathererCount(); }
+                for (auto &g : Resources::getMyGas())
+                    if (g->getStation() == s) { geysers++; wg += g->getGathererCount(); }
+                bases.push_back({{"name", regionName(s->getBase()->Center())}, {"workers_minerals", wm}, {"workers_gas", wg}, {"mineral_patches", patches},
+                                 {"gas_geysers", geysers}, {"saturation", patches > 0 ? min(1.0, double(wm) / (2.0 * patches)) : 0.0}, {"hatcheries", hatch[s]}});
+            }
+            tracker->meExtra["bases"] = bases;
+
+            nlohmann::json inProgress = nlohmann::json::object();
+            int larva = 0;
+            auto bump = [&](UnitType t) {
+                if (t == UnitTypes::None || t == UnitTypes::Unknown) return;
+                auto n = typeName(t);
+                inProgress[n] = inProgress.value(n, 0) + 1;
+            };
+            for (auto u : Broodwar->self()->getUnits()) {
+                if (!u->exists()) continue;
+                auto t = u->getType();
+                if (t == Zerg_Larva) { larva++; continue; }
+                if (t == Zerg_Egg || t == Zerg_Cocoon) { bump(u->getBuildType()); continue; }
+                if (t == Zerg_Lurker_Egg) { bump(Zerg_Lurker); continue; }
+                if (u->isMorphing() && t.isBuilding()) { bump(u->getBuildType()); continue; }
+                if (t.isBuilding() && !u->isCompleted()) bump(t);
+            }
+            tracker->meExtra["production"] = {{"in_progress", inProgress}, {"larva", larva}};
+        }
+
+        // ---- item B: execution feedback -------------------------------------------------------------------------
+        struct OverrideStatus {
+            bool applied = false;
+            string before, after, note;
+        };
+        map<string, OverrideStatus> overrides;   // current status per directive field (cleared when the directive changes)
+        map<string, string> overrideLogged;      // last logged before/after pair per field
+        string overridesForId;                   // directive id the statuses belong to
+        int directiveStartDrones = -1;           // drone count when the current directive id was first seen
+
+        void recordOverride(const string &field, bool applied, const string &before, const string &after, const string &note = "")
+        {
+            overrides[field] = {applied, before, after, note};
+            auto key         = (applied ? "A|" : "S|") + before + "|" + after + "|" + note;
+            auto &last       = overrideLogged[field];
+            if (last != key) {
+                last = key;
+                LOG("Sidecar: override ", field, applied ? " applied: " : " not applied: ", before, " -> ", after, note.empty() ? "" : " (" + note + ")");
+            }
+        }
+
+        string compositionString(const map<UnitType, double> &mix)
+        {
+            string out;
+            for (auto &[t, w] : mix) {
+                char buf[32];
+                snprintf(buf, sizeof buf, ":%.2f", w);
+                out += (out.empty() ? "" : ",") + typeName(t) + buf;
+            }
+            return out.empty() ? "none" : out;
+        }
+
+        string typeListString(const vector<UnitType> &list)
+        {
+            string out;
+            for (auto &t : list) out += (out.empty() ? "" : ",") + typeName(t);
+            return out.empty() ? "none" : out;
+        }
+
+        void fillExecution()
+        {
+            auto &d = directive();
+            if (d && d->static_defense.size() && overrides.lower_bound("static_defense") == overrides.end())
+                recordOverride("static_defense", false, "", "", "no natural wall or natural station of ours yet");
+            nlohmann::json ov = nlohmann::json::array();
+            for (auto &[field, o] : overrides)   // "static_defense.sunken" / ".spore" are two entries of field "static_defense"
+                ov.push_back({{"field", field.substr(0, field.find('.'))}, {"applied", o.applied}, {"before", o.before}, {"after", o.after}, {"note", o.note}});
+
+            nlohmann::json army = nlohmann::json::object();
+            int sunken = 0, spore = 0, drones = 0;
+            for (auto u : Broodwar->self()->getUnits()) {
+                if (!u->exists()) continue;
+                auto t = u->getType();
+                if (t == Zerg_Sunken_Colony || (t == Zerg_Creep_Colony && u->getBuildType() == Zerg_Sunken_Colony)) sunken++;
+                if (t == Zerg_Spore_Colony || (t == Zerg_Creep_Colony && u->getBuildType() == Zerg_Spore_Colony)) spore++;
+                if (t == Zerg_Drone) drones++;
+                if (isZergArmyType(t)) { auto n = typeName(t); army[n] = army.value(n, 0) + 1; }
+            }
+            if (directiveStartDrones < 0 && d) directiveStartDrones = drones;
+            tracker->executionExtra["overrides"] = ov;
+            tracker->executionExtra["results"]   = {{"sunken", sunken}, {"spore", spore}, {"army_actual", army}, {"drones", drones},
+                                                    {"drone_delta_since_directive", directiveStartDrones >= 0 ? drones - directiveStartDrones : 0}};
+        }
+
+        // ---- item C: engagement events (10 s sliding loss window) ----------------------------------------------
+        struct Loss {
+            int frame;
+            bool mine;
+            int value;
+            string name;
+            Position pos;
+        };
+        deque<Loss> lossWindow;
+        static const int engagementThreshold = [] { const char* v = std::getenv("SC_AI_ENGAGE_THRESHOLD"); return v ? std::atoi(v) : 400; }();
+        const int lossWindowFrames = 240, engagementQuietFrames = 120;
+        bool inEngagement = false;
+        int engagementStart = 0, lastLossFrame = 0, engMyValue = 0, engEnemyValue = 0, engN = 0;
+        long long engX = 0, engY = 0;
+        map<string, int> engMyLosses, engEnemyLosses;
+
+        int lossValue(UnitType t)
+        {
+            int v = t.mineralPrice() + t.gasPrice();
+            if (t.isTwoUnitsInOneEgg()) v /= 2;
+            return v;
+        }
+
+        void addToEngagement(const Loss &l)
+        {
+            (l.mine ? engMyLosses : engEnemyLosses)[l.name]++;
+            (l.mine ? engMyValue : engEnemyValue) += l.value;
+            engX += l.pos.x, engY += l.pos.y, engN++;
+            lastLossFrame = max(lastLossFrame, l.frame);
+        }
+
+        void resetEngagement()
+        {
+            inEngagement = false;
+            engMyValue = engEnemyValue = engN = 0;
+            engX = engY = 0;
+            engMyLosses.clear(), engEnemyLosses.clear();
+        }
+
+        void updateEngagement()
+        {
+            const int frame = Broodwar->getFrameCount();
+            while (!lossWindow.empty() && lossWindow.front().frame < frame - lossWindowFrames) lossWindow.pop_front();
+            if (!inEngagement) {
+                int total = 0;
+                for (auto &l : lossWindow) total += l.value;
+                if (total <= engagementThreshold) return;
+                inEngagement    = true;
+                engagementStart = frame;
+                for (auto &l : lossWindow) addToEngagement(l);
+                auto where = regionName(Position(int(engX / engN), int(engY / engN)));
+                tracker->pushEvent("engagement_start", where, {{"my_losses", engMyLosses}, {"enemy_losses", engEnemyLosses}, {"my_value", engMyValue}, {"enemy_value", engEnemyValue}});
+                LOG("Sidecar: engagement_start at ", where, " my ", engMyValue, " enemy ", engEnemyValue);
+            }
+            else if (frame - lastLossFrame > engagementQuietFrames) {
+                double ratio = engMyValue > 0 ? double(engEnemyValue) / engMyValue : (engEnemyValue > 0 ? 99.0 : 1.0);
+                string outcome = ratio < 0.7 ? "lost" : ratio > 1.4 ? "won" : "even";
+                auto where = regionName(Position(int(engX / engN), int(engY / engN)));
+                tracker->pushEvent("engagement_end", where, {{"my_losses", engMyLosses}, {"enemy_losses", engEnemyLosses}, {"my_value", engMyValue}, {"enemy_value", engEnemyValue},
+                                                             {"ratio", ratio}, {"outcome", outcome}, {"start_frame", engagementStart}, {"end_frame", lastLossFrame}});
+                LOG("Sidecar: engagement_end at ", where, " ", outcome, " my ", engMyValue, " enemy ", engEnemyValue);
+                resetEngagement();
+                lossWindow.clear();
+            }
+        }
+
+        // ---- item E: map dump (SC_AI_MAP_DUMP=<path>) then leave ----------------------------------------------
+        nlohmann::json tileJ(TilePosition t) { return {t.x, t.y}; }
+        nlohmann::json tileSetJ(const set<TilePosition> &tiles)
+        {
+            nlohmann::json a = nlohmann::json::array();
+            for (auto &t : tiles) a.push_back(tileJ(t));
+            return a;
+        }
+        nlohmann::json wallJ(BWEB::Wall *wall)
+        {
+            if (!wall) return nullptr;
+            nlohmann::json buildings = nlohmann::json::array(), defenses = nlohmann::json::array();
+            for (auto &t : wall->getRawBuildings()) buildings.push_back(typeName(t));
+            for (auto &t : wall->getRawDefenses()) defenses.push_back(typeName(t));
+            nlohmann::json defRows = nlohmann::json::array();
+            for (int row = 0; row < 3; row++) {
+                if (wall->getDefenses(row).empty()) break;
+                defRows.push_back(tileSetJ(wall->getDefenses(row)));
+            }
+            return {{"choke_tile", wall->getChokePoint() ? tileJ(TilePosition(Position(wall->getChokePoint()->Center()))) : nlohmann::json(nullptr)},
+                    {"station_region", wall->getStation() ? regionName(wall->getStation()->getBase()->Center()) : "unknown"},
+                    {"buildings", buildings}, {"defense_types", defenses},
+                    {"large_tiles", tileSetJ(wall->getLargeTiles())}, {"medium_tiles", tileSetJ(wall->getMediumTiles())}, {"small_tiles", tileSetJ(wall->getSmallTiles())},
+                    {"openings", tileSetJ(wall->getOpenings())}, {"defense_tiles_by_row", defRows},
+                    {"ground_defense_count_planned", wall->getGroundDefenseCount()},
+                    {"open_wall", true},   // McRave::Walls::findWalls() creates every natural wall with openWall = true
+                    {"zergling_tight", nullptr}, // BWEB::Wall keeps tightType/requireTight private; McRave builds Zerg walls with tight = false
+                    {"note", "McRave Zerg natural walls are open (tight=false, openWall=true): not zergling-tight by construction"}};
+        }
+
+        void writeMapDump(const string &path)
+        {
+            nlohmann::json j;
+            j["map"]      = Broodwar->mapName();
+            j["map_file"] = Broodwar->mapFileName();
+            j["size_tiles"] = {Broodwar->mapWidth(), Broodwar->mapHeight()};
+            j["our_start_tile"] = tileJ(Broodwar->self()->getStartLocation());
+            nlohmann::json starts = nlohmann::json::array();
+            for (auto &t : Broodwar->getStartLocations()) starts.push_back(tileJ(t));
+            j["start_locations"] = starts;
+            // "regions" in the converter's format (tools/map_knowledge_from_dump.py: {name: [x, y]}); owners in "regions_detail".
+            nlohmann::json regionsFlat = nlohmann::json::object();
+            for (auto &r : regions) { auto t = TilePosition(r.pos); regionsFlat[r.name] = {t.x, t.y}; }
+            j["regions"]        = regionsFlat;
+            j["regions_detail"] = regionsJson();
+
+            auto myMain = Terrain::getMyMain();
+            nlohmann::json bases = nlohmann::json::array();
+            for (auto &s : BWEB::Stations::getStations()) {
+                auto base = s.getBase();
+                int mineralsTotal = 0;
+                for (auto m : base->Minerals()) mineralsTotal += m->InitialAmount();
+                int gasTotal = 0;
+                for (auto g : base->Geysers()) gasTotal += g->InitialAmount();
+                auto gd = myMain ? BWEB::Map::getGroundDistance(myMain->getBase()->Center(), base->Center()) : DBL_MAX;
+                bases.push_back({{"tile", tileJ(base->Location())}, {"center_tile", tileJ(TilePosition(base->Center()))}, {"minerals", int(base->Minerals().size())},
+                                 {"minerals_total", mineralsTotal}, {"gas", int(base->Geysers().size())}, {"gas_total", gasTotal}, {"isStart", base->Starting()},
+                                 {"is_main", s.isMain()}, {"is_natural", s.isNatural()}, {"area_id", base->GetArea() ? base->GetArea()->Id() : -1},
+                                 {"region", regionName(base->Center())}, {"owner", ownerOf(&s)},
+                                 {"ground_distance_from_main", gd < 1e9 ? nlohmann::json(int(gd)) : nlohmann::json(nullptr)},
+                                 {"defense_tiles", tileSetJ(s.getDefenses())}});
+            }
+            j["bases"] = bases;
+
+            nlohmann::json chokes = nlohmann::json::array();
+            set<const BWEM::ChokePoint *> seen;
+            for (auto &area : mapBWEM.Areas()) {
+                for (auto cp : area.ChokePoints()) {
+                    if (!seen.insert(cp).second) continue;
+                    auto ct = TilePosition(Position(cp->Center()));
+                    chokes.push_back({{"center", tileJ(ct)}, {"center_tile", tileJ(ct)}, {"width", cp->Width()}, {"width_tiles", cp->Width() / 32},
+                                      {"areas", {cp->GetAreas().first->Id(), cp->GetAreas().second->Id()}}, {"blocked", cp->Blocked()},
+                                      {"is_main_choke", cp == Terrain::getMainChoke()}, {"is_natural_choke", cp == Terrain::getNaturalChoke()},
+                                      {"region", regionName(Position(cp->Center()))}});
+                }
+            }
+            j["chokes"] = chokes;
+
+            j["wall_natural"] = wallJ(Walls::getNaturalWall());
+            j["wall_main"]    = wallJ(Walls::getMainWall());
+            // Converter keys: "natural_wall" {buildings, tiles (all wall building tiles), zergling_tight}, "natural_defenses" [[x, y], ...]
+            // (BWEB defense tiles of the natural station, then the wall's first defense row).
+            auto nat = Terrain::getMyNatural();
+            if (auto wall = Walls::getNaturalWall()) {
+                nlohmann::json tiles = nlohmann::json::array();
+                for (auto &t : wall->getLargeTiles()) tiles.push_back(tileJ(t));
+                for (auto &t : wall->getMediumTiles()) tiles.push_back(tileJ(t));
+                for (auto &t : wall->getSmallTiles()) tiles.push_back(tileJ(t));
+                j["natural_wall"] = {{"buildings", j["wall_natural"]["buildings"]}, {"tiles", tiles}, {"zergling_tight", false}, {"open_wall", true}};
+            }
+            else
+                j["natural_wall"] = nullptr;
+            nlohmann::json natDef = nlohmann::json::array();
+            if (nat) {
+                for (auto &t : nat->getDefenses()) natDef.push_back(tileJ(t));
+                if (auto wall = Walls::getNaturalWall()) for (auto &t : wall->getDefenses(0)) natDef.push_back(tileJ(t));
+            }
+            j["natural_defenses"] = natDef;
+            j["natural_detail"]   = nat ? nlohmann::json({{"station_defense_tiles", tileSetJ(nat->getDefenses())},
+                                                          {"pocket_defense_tile", nat->getPocketDefense().isValid() ? tileJ(nat->getPocketDefense()) : nlohmann::json(nullptr)},
+                                                          {"defend_position_tile", tileJ(TilePosition(Stations::getDefendPosition(nat)))}})
+                                        : nlohmann::json(nullptr);
+            nlohmann::json order = nlohmann::json::array();
+            for (auto s : Expansion::getExpandOrder()) order.push_back({{"tile", tileJ(s->getBase()->Location())}, {"region", regionName(s->getBase()->Center())}});
+            j["expand_order"] = order;
+
+            ofstream f(path);
+            f << j.dump(2) << endl;
+            LOG("Sidecar: map dump written to ", path, " (", bases.size(), " bases, ", chokes.size(), " chokes), leaving game");
+        }
+
+        // ---- hook 2 payload extras -----------------------------------------------------------------------------
+        void fillCombatSim()
+        {
+            nlohmann::json sim = nlohmann::json::object();
+            auto mine  = Players::getStrength(PlayerState::Self);
+            auto enemy = Players::getStrength(PlayerState::Enemy);
+            auto myTotal    = mine.groundToGround + mine.groundToAir + mine.airToGround + mine.airToAir;
+            auto enemyTotal = enemy.groundToGround + enemy.groundToAir + enemy.airToGround + enemy.airToAir;
+            sim["my_strength"]    = myTotal;
+            sim["enemy_strength"] = enemyTotal;
+            if (enemyTotal > 0.0)
+                sim["my_army_vs_seen"] = myTotal / enemyTotal;
+            sim["my_ground_to_ground"]    = mine.groundToGround;
+            sim["enemy_ground_to_ground"] = enemy.groundToGround;
+            sim["enemy_air_to_ground"]    = enemy.airToGround;
+
+            // Horizon per-unit simulation: fraction of combat units currently in SimState::Win and their mean sim value
+            int combat = 0, wins = 0, attacking = 0;
+            double simSum = 0.0;
+            for (auto &u : Units::getUnits(PlayerState::Self)) {
+                if (u->getRole() != Role::Combat)
+                    continue;
+                combat++;
+                simSum += u->getSimValue();
+                if (u->getSimState() == SimState::Win) wins++;
+                if (u->getGlobalState() == GlobalState::Attack) attacking++;
+            }
+            if (combat > 0) {
+                sim["sim_win_fraction"]   = double(wins) / combat;
+                sim["sim_value_mean"]     = simSum / combat;
+                sim["global_attack_frac"] = double(attacking) / combat;
+            }
+            sim["enemy_threatening"] = Units::enemyThreatening() ? 1.0 : 0.0;
+            tracker->combatSim = sim;
+        }
+
+        void fillBodyDefaults()
+        {
+            nlohmann::json d = nlohmann::json::object();
+            d["build"]      = BuildOrder::getCurrentBuild();
+            d["opener"]     = BuildOrder::getCurrentOpener();
+            d["transition"] = BuildOrder::getCurrentTransition();
+            d["opening"]    = BuildOrder::getCurrentBuild() + "/" + BuildOrder::getCurrentOpener() + "/" + BuildOrder::getCurrentTransition();
+            d["stance"]     = BuildOrder::isAllIn() ? "all_in" : (BuildOrder::isPressure() || BuildOrder::isRush()) ? "aggressive" : "defensive";
+            d["expand"]     = BuildOrder::shouldExpand() ? "now" : "hold";
+            d["wall_natural"] = BuildOrder::isWallNat() ? "natural_wall" : "none";
+            d["in_opening"] = inOpening ? "true" : "false";
+            d["enemy_build"]      = Spy::getEnemyBuild();
+            d["enemy_opener"]     = Spy::getEnemyOpener();
+            d["enemy_transition"] = Spy::getEnemyTransition();
+            tracker->bodyDefaults = d;
