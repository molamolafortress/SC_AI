+        // ---- configuration -------------------------------------------------------------------------------------
+        struct Config {
+            bool enabled   = false;
+            string host    = "127.0.0.1";
+            int port       = 8770;
+            int every      = 24;
+            int timeoutMs  = 2000;
+        };
+
+        Config readConfig()
+        {
+            Config c;
+            ifstream ini("bwapi-data/sidecar.ini");
+            if (ini.is_open()) {
+                c.enabled = true;
+                string line;
+                while (getline(ini, line)) {
+                    auto eq = line.find('=');
+                    if (line.empty() || line[0] == '#' || line[0] == ';' || eq == string::npos)
+                        continue;
+                    auto key = line.substr(0, eq), val = line.substr(eq + 1);
+                    auto trim = [](string s) {
+                        while (!s.empty() && isspace(static_cast<unsigned char>(s.back()))) s.pop_back();
+                        size_t i = 0;
+                        while (i < s.size() && isspace(static_cast<unsigned char>(s[i]))) i++;
+                        return s.substr(i);
+                    };
+                    key = trim(key), val = trim(val);
+                    if (key == "host") c.host = val;
+                    else if (key == "port") c.port = atoi(val.c_str());
+                    else if (key == "every") c.every = max(1, atoi(val.c_str()));
+                    else if (key == "timeout_ms") c.timeoutMs = max(1, atoi(val.c_str()));
+                    else if (key == "enabled") c.enabled = !(val == "0" || val == "false" || val == "no");
+                }
+            }
+            if (const char *h = getenv("SIDECAR_HOST")) { c.enabled = true; c.host = h; }
+            if (const char *p = getenv("SIDECAR_PORT")) { c.enabled = true; c.port = atoi(p); }
+            return c;
+        }
