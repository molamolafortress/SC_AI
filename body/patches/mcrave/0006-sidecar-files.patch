+    // Named region for a position: nearest of main/natural/third/fourth/enemy_main/enemy_natural/enemy_third/center/path_mid
+    // within 12 tiles, else "unknown_area_<BWEM area id>".
+    string regionNameFor(Position p) { return regionName(p); }
+
+    // Directive for the override hooks: empty when disabled or when the sidecar only observes (baseline runs).
+    const optional<Directive> &directive() { return (enabled() && current && !current->observe_only) ? current : none; }
+
+    // ---- hook 1 ------------------------------------------------------------------------------------------------
+    void applyOpening()
+    {
+        auto &d = directive();
+        if (!d || d->opening.empty())
+            return;
+        string build, opener, transition;
+        const string cur = currentBuild + "/" + currentOpener + "/" + currentTransition;
+        if (!resolveOpening(d->opening, build, opener, transition)) {
+            warnOnce("opening '" + d->opening + "' has no allowed McRave build for this matchup, keeping " + cur);
+            recordOverride("opening", false, cur, d->opening, "no allowed McRave build for this matchup");
+            return;
+        }
+        // Apply once per directive: the LLM sets the opening when it decides; McRave's own scouting reactions may
+        // change it afterwards (the body stays reactive), and the next directive (triggered by the same event) re-decides.
+        static string lastAppliedId;
+        if (d->directive_id == lastAppliedId)
+            return;
+        lastAppliedId = d->directive_id;
+        const string target = build + "/" + opener + "/" + transition;
+        auto buildChange = (build != currentBuild || opener != currentOpener);
+        // Build/opener may only change before the transition started; a transition-only change is fine while the book is active.
+        if (buildChange && inTransition) {
+            recordOverride("opening", false, cur, target, "transition already started");
+            return;
+        }
+        if (!buildChange && transition == currentTransition) {
+            recordOverride("opening", true, cur, target, "already current");
+            return;
+        }
+        if (!inOpening) {
+            recordOverride("opening", false, cur, target, "opening book finished");
+            return;
+        }
+        LOG("Sidecar: opening ", d->opening, " -> ", build, "/", opener, "/", transition, " (was ", currentBuild, "/", currentOpener, "/", currentTransition, ")");
+        BuildOrder::setLearnedBuild(build, opener, transition);
+        recordOverride("opening", true, cur, target);
+    }
+
+    void applyBuildFlags()
+    {
+        auto &d = directive();
+        if (!d)
+            return;
+        if (Broodwar->self()->getRace() != Races::Zerg)
+            return;
+        const string before = wallNat ? "natural_wall" : "none";
+        wallNat = norm(d->wall_natural) != "none" && !d->wall_natural.empty();
+        recordOverride("wall", true, before, wallNat ? "natural_wall" : "none", Walls::getNaturalWall() ? "" : "McRave found no natural wall on this map");
+        if (d->stance == "all_in")
+            pressure = true;
+    }
+
+    bool techPriorityActive()
+    {
+        auto &d = directive();
+        if (!d || d->tech_priority.empty())
+            return false;
+        for (auto &name : d->tech_priority)
+            if (isZergArmyType(unitTypeFromName(name)))
+                return true;
+        return false;
+    }
+
+    void applyTechPriority()
+    {
+        auto &d = directive();
+        if (!d || d->tech_priority.empty())
+            return;
+        // Only army unit names form McRave's unitOrder (tech path). Upgrades/buildings in the list ("metabolic_boost",
+        // "lair") are left to McRave's own queueUpgrades()/getTechBuildings().
+        vector<UnitType> order;
+        string requested;
+        for (auto &name : d->tech_priority) {
+            requested += (requested.empty() ? "" : ",") + name;
+            auto t = unitTypeFromName(name);
+            if (isZergArmyType(t) && find(order.begin(), order.end(), t) == order.end())
+                order.push_back(t);
+        }
+        if (order.empty()) {
+            recordOverride("tech_priority", false, typeListString(unitOrder), requested, "no army unit names (upgrades/buildings stay McRave's)");
+            return;
+        }
+        recordOverride("tech_priority", true, typeListString(unitOrder), typeListString(order));
+        unitOrder = order;
+    }
+
+    void applyComposition()
+    {
+        auto &d = directive();
+        if (!d || d->unit_mix_target.empty())
+            return;
+        if (inOpening && d->keep_current_plan) {
+            recordOverride("unit_mix", false, compositionString(armyComposition), "", "opening book with keep_current_plan");
+            return; // leave the opening book's one-hot ladder alone
+        }
+        map<UnitType, double> mix;
+        string locked;
+        for (auto &[name, weight] : d->unit_mix_target) {
+            auto t = unitTypeFromName(name);
+            if (t == UnitTypes::None || weight <= 0.0) {
+                if (t == UnitTypes::None) warnOnce("unit_mix_target: unknown unit '" + name + "'");
+                continue;
+            }
+            if (t == Zerg_Drone || t == Zerg_Overlord) { mix[t] = weight; continue; }
+            if (!isZergArmyType(t)) continue;
+            if (!BuildOrder::unlockReady(t)) {
+                focusUnits.insert(t); // getTechBuildings() will queue the prerequisites
+                locked += (locked.empty() ? "" : ",") + typeName(t);
+                continue;
+            }
+            mix[t] = weight;
+        }
+        if (mix.empty()) {
+            recordOverride("unit_mix", false, compositionString(armyComposition), "", locked.empty() ? "no known unlocked unit in the target" : "tech not unlocked yet: " + locked);
+            return;
+        }
+        recordOverride("unit_mix", true, compositionString(armyComposition), compositionString(mix), locked.empty() ? "" : "tech queued for: " + locked);
+        armyComposition = mix;
+    }
+
+    // Economy lever (drone_target). Runs as the last step of composition(), so it sees McRave's final armyComposition
+    // (and applyComposition()'s). Producing::updateLarva() picks the larva type by getCompositionPercentage(), and
+    // unlocks() derives unlockedType from armyComposition, so the drone weight set here is what decides whether the
+    // next larva becomes a drone. McRave's per-station hard cap stays (Producing::validLarva(): no drone when the
+    // closest station's saturation >= 2.0), so `total` can never exceed ~2x the mineral patches we own.
+    void applyDroneTarget()
+    {
+        auto &d = directive();
+        if (!d || d->drone_target_total <= 0)
+            return;
+        if (Broodwar->self()->getRace() != Races::Zerg)
+            return;
+        const int target  = d->drone_target_total;
+        const int current = vis(Zerg_Drone);
+        const string before = compositionString(armyComposition);
+        const string want   = "total=" + to_string(target) + "," + norm(d->drone_target_priority) + ",have=" + to_string(current);
+        if (inOpening && !d->drone_target_override_opening) {
+            recordOverride("drone_target", false, before, want, "opening book (override_opening=false)");
+            return;
+        }
+        auto priority = norm(d->drone_target_priority);
+        if (priority != "economy" && priority != "army") priority = "balanced";
+
+        if (current >= target) {
+            // At/above target: stop droning. If that empties the composition, McRave's own fallback is lings.
+            armyComposition.erase(Zerg_Drone);
+            bool anyArmy = false;
+            for (auto &[t, w] : armyComposition) if (w > 0.0) anyArmy = true;
+            if (!anyArmy && com(Zerg_Spawning_Pool) > 0)
+                armyComposition[Zerg_Zergling] = 1.0;
+            recordOverride("drone_target", true, before, compositionString(armyComposition), "target reached, droning stopped");
+            return;
+        }
+
+        // Below target.
+        if (priority == "economy") {
+            // All larva to drones until the target is reached (same shape as the opening book's zergUnitPump[Drone]).
+            armyComposition.clear();
+            armyComposition[Zerg_Drone] = 1.0;
+        }
+        else if (priority == "balanced") {
+            // Drones compete with McRave's army picks; Producing::scoreUnit() = percentage / trained count, so the rarer type wins.
+            armyComposition[Zerg_Drone] = 1.0;
+            // McRave's "lings when saturated" fallback (ling=1, drone=0) would out-score drones (fewer lings than drones);
+            // drop it when lings are the only army entry. Tech units chosen by the priority ladder stay.
+            bool otherArmy = false;
+            for (auto &[t, w] : armyComposition) if (t != Zerg_Drone && t != Zerg_Zergling && w > 0.0) otherArmy = true;
+            if (!otherArmy) armyComposition.erase(Zerg_Zergling);
+        }
+        else { // "army": McRave's army composition first; drones only when it asks for nothing else
+            bool anyArmy = false;
+            for (auto &[t, w] : armyComposition) if (t != Zerg_Drone && w > 0.0) anyArmy = true;
+            if (!anyArmy) {
+                armyComposition.clear();
+                armyComposition[Zerg_Drone] = 1.0;
+            }
+        }
+        recordOverride("drone_target", true, before, compositionString(armyComposition), "below target by " + to_string(target - current) + ", priority " + priority);
+    }
+
+    void applyExpandPolicy(int hatchCount)
+    {
+        auto &d = directive();
+        if (!d)
+            return;
+        auto policy = norm(d->expand_policy);
+        auto stateStr = [&] { return string(expandDesired ? "expand" : "hold") + ",hatch_queue=" + to_string(buildQueue[Zerg_Hatchery]); };
+        const string before = stateStr();
+        if (policy == "never") {
+            expandDesired = false;
+            wantThird     = false;
+            if (int(Stations::getStations(PlayerState::Self).size()) >= 2)
+                wantNatural = false;
+            buildQueue[Zerg_Hatchery] = min(buildQueue[Zerg_Hatchery], hatchCount);
+            recordOverride("expand_policy", true, before, stateStr());
+        }
+        else if (policy == "greedy") {
+            if (Stations::getMiningStationsCount() <= 5 && vis(Zerg_Hatchery) - com(Zerg_Hatchery) == 0) {
+                expandDesired             = true;
+                buildQueue[Zerg_Hatchery] = max(buildQueue[Zerg_Hatchery], hatchCount + 1);
+                if (int(Stations::getStations(PlayerState::Self).size()) <= 1) wantNatural = true;
+                if (int(Stations::getStations(PlayerState::Self).size()) <= 2) wantThird = true;
+                recordOverride("expand_policy", true, before, stateStr());
+            }
+            else
+                recordOverride("expand_policy", false, before, before, vis(Zerg_Hatchery) - com(Zerg_Hatchery) > 0 ? "hatchery already in progress" : "6+ mining stations");
+        }
+        else
+            recordOverride("expand_policy", true, before, before, "allow_when_safe: McRave decides");
+        // "allow_when_safe": McRave's own expandDesired logic
+    }
+
+    void applyStance(vector<UnitType> &staticRetreatTypes)
+    {
+        auto &d = directive();
+        if (!d)
+            return;
+        auto stance = norm(d->stance);
+        const string before = "retreat_types=" + typeListString(staticRetreatTypes);
+        if (stance == "defensive") {
+            for (auto &t : BuildOrder::getUnlockedList()) {
+                if (isZergArmyType(t) && find(staticRetreatTypes.begin(), staticRetreatTypes.end(), t) == staticRetreatTypes.end())
+                    staticRetreatTypes.push_back(t);
+            }
+            recordOverride("stance", true, before, "retreat_types=" + typeListString(staticRetreatTypes));
+        }
+        else if (stance == "aggressive" || stance == "all_in") {
+            staticRetreatTypes.clear(); // workers are re-added by updateStaticStates() right after this call
+            recordOverride("stance", true, before, "retreat_types=none", stance == "all_in" ? "pressure=true" : "");
+        }
+        else
+            recordOverride("stance", true, before, before, "neutral: McRave decides");
+        // "neutral": McRave's own rules
+    }
+
+    void applyAttackPosition(Position &attackPosition)
+    {
+        auto &d = directive();
+        if (!d || !isAttackObjective(norm(d->objective_type)))
+            return;
+        auto station = stationFor(d->objective_location);
+        const string before = regionName(attackPosition);
+        if (!station || Stations::ownedBy(station) != PlayerState::Enemy) {
+            recordOverride("objective", false, before, norm(d->objective_type) + "@" + norm(d->objective_location), !station ? "location not a named station" : "station not enemy-owned (yet)");
+            return; // unknown or not (yet) enemy-owned: McRave's own target
+        }
+        attackPosition = station->getResourceCentroid();
+        recordOverride("objective", true, before, norm(d->objective_type) + "@" + regionName(attackPosition));
+    }
+
+    void applyDefendPosition(bool &defendNatural, bool &holdNatural, const BWEM::ChokePoint *&defendChoke, const BWEM::Area *&defendArea, Position &defendPosition,
+                             const BWEB::Station *&defendStation)
+    {
+        auto &d = directive();
+        if (!d || !isDefendObjective(norm(d->objective_type)))
+            return;
+        auto l = norm(d->objective_location);
+        const string before = regionName(defendPosition);
+        const string target = norm(d->objective_type) + "@" + l;
+        if (l == "natural") {
+            auto nat = Terrain::getMyNatural();
+            if (!nat || !Terrain::getNaturalChoke() || Stations::ownedBy(nat) != PlayerState::Self) {
+                recordOverride("objective", false, before, target, "natural not ours yet");
+                return; // not ours yet: keep McRave's choice
+            }
+            recordOverride("objective", true, before, target);
+            defendNatural  = true;
+            holdNatural    = true;
+            defendChoke    = Terrain::getNaturalChoke();
+            defendArea     = Terrain::getNaturalArea();
+            defendPosition = Stations::getDefendPosition(nat);
+            defendStation  = nat;
+        }
+        else if (l == "main") {
+            auto main = Terrain::getMyMain();
+            if (!main || !Terrain::getMainChoke()) {
+                recordOverride("objective", false, before, target, "no main choke");
+                return;
+            }
+            recordOverride("objective", true, before, target);
+            defendNatural  = false;
+            holdNatural    = false;
+            defendChoke    = Terrain::getMainChoke();
+            defendArea     = Terrain::getMainArea();
+            defendPosition = Stations::getDefendPosition(main);
+            defendStation  = main;
+        }
+        else
+            recordOverride("objective", false, before, target, "location not main|natural (coordinates stay body-side)");
+    }
+
+    // Static defense counts apply to the natural only (wall if McRave made one there, else the natural station).
+    namespace {
+        optional<int> defenseFor(const char *key, int have)
+        {
+            auto &d = directive();
+            if (!d)
+                return nullopt;
+            auto it = d->static_defense.find(key);
+            if (it == d->static_defense.end())
+                return nullopt;
+            recordOverride(string("static_defense.") + key, true, string(key) + " have=" + to_string(have), string(key) + " want=" + to_string(max(0, it->second)));
+            return max(0, it->second) - have;
+        }
+        bool isNaturalWall(const BWEB::Wall *wall) { return wall && wall == Walls::getNaturalWall() && wall->getStation() && wall->getStation()->isNatural(); }
+        bool isNaturalStationWithoutWall(const BWEB::Station *station) { return station && station->isNatural() && !Walls::getNaturalWall(); }
+    } // namespace
+
+    optional<int> groundDefensesFor(const BWEB::Wall *wall) { return isNaturalWall(wall) ? defenseFor("sunken", wall->getGroundDefenseCount()) : nullopt; }
+    optional<int> airDefensesFor(const BWEB::Wall *wall) { return isNaturalWall(wall) ? defenseFor("spore", wall->getAirDefenseCount()) : nullopt; }
+    optional<int> groundDefensesFor(const BWEB::Station *station)
+    {
+        return isNaturalStationWithoutWall(station) ? defenseFor("sunken", Stations::getGroundDefenseCount(station)) : nullopt;
+    }
+    optional<int> airDefensesFor(const BWEB::Station *station)
+    {
+        return isNaturalStationWithoutWall(station) ? defenseFor("spore", Stations::getAirDefenseCount(station)) : nullopt;
+    }
+} // namespace McRave::Sidecar
