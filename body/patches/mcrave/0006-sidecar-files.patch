+        // ---- opening mapping: Directive.opening (knowledge/builds names) -> McRave build/opener/transition -------
+        struct OpeningMap {
+            string build, opener, transition; // "" = keep McRave's current value
+        };
+        const map<string, OpeningMap> openingTable = {
+            // openers (build + opener; transition kept if still allowed, else first allowed for that build)
+            {"12hatch_11pool", {"HatchPool", "12Hatch", ""}},
+            {"12hatch",        {"HatchPool", "12Hatch", ""}},
+            {"11hatch",        {"HatchPool", "11Hatch", ""}},
+            {"10hatch",        {"HatchPool", "10Hatch", ""}},
+            {"9hatch",         {"HatchPool", "9Hatch", ""}},
+            {"3hatch",         {"HatchPool", "3Hatch", ""}},
+            {"3hatch_before_pool", {"HatchPool", "3Hatch", ""}},
+            {"overpool",       {"PoolHatch", "Overpool", ""}},
+            {"12pool",         {"PoolHatch", "12Pool", ""}},
+            {"9pool",          {"PoolLair", "9Pool", ""}},
+            {"9pool_speed",    {"PoolLair", "9Pool", ""}},
+            {"gaspool",        {"PoolLair", "Gaspool", ""}},
+            {"4pool",          {"PoolLair", "4Pool", ""}},
+            // transitions (build + opener kept)
+            {"1hatch_muta",    {"", "", "1HatchMuta"}},
+            {"2hatch_muta",    {"", "", "2HatchMuta"}},
+            {"3hatch_muta",    {"", "", "3HatchMuta"}},
+            {"2hatch_hydra",   {"", "", "2HatchHydra"}},
+            {"3hatch_hydra",   {"", "", "3HatchHydra"}},
+            {"4hatch_hydra",   {"", "", "4HatchHydra"}},
+            {"6hatch_hydra",   {"", "", "6HatchHydra"}},
+            {"1hatch_lurker",  {"", "", "1HatchLurker"}},
+            {"2hatch_lurker",  {"", "", "2HatchLurker"}},
+            {"lurker_contain", {"", "", "1HatchLurker"}},
+            {"2hatch_speedling", {"", "", "2HatchSpeedling"}},
+            {"3hatch_speedling", {"", "", "3HatchSpeedling"}},
+        };
+
+        // Validate a tuple against the same table the /bo chat command and Learning use (Learning::getBuilds()).
+        // Returns true and fills the tuple if the combination is allowed for this matchup.
+        // McRave native names ("PoolHatch/12Pool/2HatchMuta", "2HatchMuta", "HatchPool/12Hatch"): each '/'-separated part is
+        // matched case-insensitively against Learning's build, opener and transition names. Unmatched parts fail.
+        bool resolveNativeOpening(const string &name, string &build, string &opener, string &transition)
+        {
+            auto &builds = Learning::getBuilds();
+            if (builds.empty())
+                return false;
+            build = currentBuild, opener = currentOpener, transition = currentTransition;
+            bool matched = false;
+            size_t pos = 0;
+            while (pos <= name.size()) {
+                auto next = name.find('/', pos);
+                auto part = norm(name.substr(pos, next == string::npos ? string::npos : next - pos));
+                pos       = next == string::npos ? name.size() + 1 : next + 1;
+                if (part.empty())
+                    continue;
+                bool found = false;
+                for (auto &b : builds) {
+                    if (norm(b.name) == part) { build = b.name; found = true; break; }
+                    for (auto &o : b.openers)
+                        if (norm(o.name) == part) { opener = o.name; found = true; break; }
+                    if (found) break;
+                    for (auto &t : b.transitions)
+                        if (norm(t.name) == part) { transition = t.name; found = true; break; }
+                    if (found) break;
+                }
+                if (!found)
+                    return false;
+                matched = true;
+            }
+            return matched;
+        }
+
+        bool resolveOpening(const string &name, string &build, string &opener, string &transition)
+        {
+            bool fromTable = false;
+            auto it = openingTable.find(norm(name));
+            if (it != openingTable.end()) {
+                fromTable  = true;
+                build      = it->second.build.empty() ? currentBuild : it->second.build;
+                opener     = it->second.opener.empty() ? currentOpener : it->second.opener;
+                transition = it->second.transition.empty() ? currentTransition : it->second.transition;
+            }
+            else if (!resolveNativeOpening(name, build, opener, transition))
+                return false;
+            const bool keepTransition = fromTable ? it->second.transition.empty() : (transition == currentTransition);
+
+            auto &builds = Learning::getBuilds();
+            if (builds.empty())
+                return false; // FFA / no enemy: Learning did not build the table, do not guess
+            for (auto &b : builds) {
+                if (b.name != build)
+                    continue;
+                auto hasOpener = any_of(b.openers.begin(), b.openers.end(), [&](auto &o) { return o.name == opener; });
+                auto hasTrans  = any_of(b.transitions.begin(), b.transitions.end(), [&](auto &t) { return t.name == transition; });
+                if (!hasOpener)
+                    return false;
+                if (!hasTrans) {
+                    if (keepTransition && !b.transitions.empty())
+                        transition = b.transitions.front().name; // build changed: keep-transition no longer fits, use first allowed
+                    else
+                        return false;
+                }
+                return true;
+            }
+            return false;
+        }
