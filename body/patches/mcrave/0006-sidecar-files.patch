+        // ---- name helpers --------------------------------------------------------------------------------------
+        string norm(string s)
+        {
+            string out;
+            for (auto ch : s) {
+                if (ch == ' ' || ch == '-') ch = '_';
+                out += static_cast<char>(tolower(static_cast<unsigned char>(ch)));
+            }
+            return out;
+        }
+
+        // "zergling" -> Zerg_Zergling. Accepts StateTracker's normalised names ("spawning_pool") and a few aliases.
+        UnitType unitTypeFromName(const string &raw)
+        {
+            static map<string, UnitType> table;
+            if (table.empty()) {
+                for (auto &t : UnitTypes::allUnitTypes()) {
+                    if (t.getRace() != Races::Zerg)
+                        continue;
+                    string n = t.getName();
+                    if (n.rfind("Zerg_", 0) == 0) n = n.substr(5);
+                    table[norm(n)] = t;
+                }
+                table["ling"]  = Zerg_Zergling;
+                table["lings"] = Zerg_Zergling;
+                table["muta"]  = Zerg_Mutalisk;
+                table["mutas"] = Zerg_Mutalisk;
+                table["hydra"] = Zerg_Hydralisk;
+                table["ultra"] = Zerg_Ultralisk;
+            }
+            auto it = table.find(norm(raw));
+            return it == table.end() ? UnitTypes::None : it->second;
+        }
+
+        bool isZergArmyType(UnitType t)
+        {
+            return t != UnitTypes::None && t.getRace() == Races::Zerg && !t.isBuilding() && !t.isWorker() && t != Zerg_Larva && t != Zerg_Egg && t != Zerg_Overlord &&
+                   t != Zerg_Lurker_Egg && t != Zerg_Cocoon && t != Zerg_Broodling && t != Zerg_Infested_Terran;
+        }
