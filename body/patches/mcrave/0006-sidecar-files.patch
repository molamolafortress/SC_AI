+        const BWEB::Station *stationFor(const string &location)
+        {
+            auto l = norm(location);
+            if (l == "main") return Terrain::getMyMain();
+            if (l == "natural") return Terrain::getMyNatural();
+            if (l == "enemy_main") return Terrain::getEnemyMain();
+            if (l == "enemy_natural") return Terrain::getEnemyNatural();
+            return nullptr;
+        }
