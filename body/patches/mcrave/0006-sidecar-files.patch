+// Sidecar: SC_AI hooks (body/HOOKS.md section 5). Thin wrapper around body/sidecar_client/{SidecarClient,StateTracker}.hpp.
+//
+// Enabled only when env SIDECAR_HOST or SIDECAR_PORT is set, or bwapi-data/sidecar.ini exists. Otherwise every
+// function here is a no-op and McRave plays exactly as upstream (the body must play without the sidecar).
+// Every apply*() is also a no-op when there is no valid (unexpired) directive, so an expired directive reverts
+// to McRave's own per-frame logic without any cleanup.
+#pragma once
+#include <BWAPI.h>
+
+#include <optional>
+#include <vector>
+
+namespace BWEB {
+    class Station;
+    class Wall;
+} // namespace BWEB
+namespace BWEM {
+    class ChokePoint;
+    class Area;
+} // namespace BWEM
+struct Directive; // body/sidecar_client/SidecarClient.hpp (only Sidecar.cpp sees the full type)
+
+namespace McRave::Sidecar {
+    bool enabled();
+
+    // Hook 2: lifecycle (McRaveModule)
+    void onStart();
+    void onFrame();   // top of onFrame, after Util::onFrame(): poll the latest directive, drop it if expired
+    void emitIfDue(); // end of onFrame, before Visuals::onFrame(): tracker update + StateSummary every 24 frames; hook 3 metering
+    void onUnitDiscover(BWAPI::Unit);
+    void onUnitDestroy(BWAPI::Unit);
+    void onEnd(bool isWinner);
+
+    // Current directive, only if valid(frame); otherwise an empty optional (expiry -> McRave defaults).
+    const std::optional<Directive> &directive();
+
+    // Hook 1: strategy injection. Each is called by McRave right after it computed its own value and overrides it.
+    void applyOpening();                                      // ZergBuildOrder.cpp opener(), before ZvT()/ZvP()/ZvZ()
+    void applyBuildFlags();                                   // BuildOrder.cpp updateBuild(), after Zerg::opener(): wallNat, pressure
+    void applyTechPriority();                                 // ZergBuildOrder.cpp tech(), before the unitOrder loop
+    bool techPriorityActive();                                // ZergBuildOrder.cpp switchComposition(), top: skip McRave's switch
+    void applyComposition();                                  // ZergBuildOrder.cpp composition(), last statement
+    void applyExpandPolicy(int hatchCount);                   // ZergBuildOrder.cpp queueExpansions(), after buildQueue[Hatchery] = max(..)
+    void applyStance(std::vector<BWAPI::UnitType> &staticRetreatTypes); // Combat/State.cpp updateStaticStates(), after updateZStaticStates()
+    void applyAttackPosition(BWAPI::Position &attackPosition);          // Combat.cpp onFrame(), after findAttackPosition()
+    void applyDefendPosition(bool &defendNatural, bool &holdNatural, const BWEM::ChokePoint *&defendChoke, const BWEM::Area *&defendArea,
+                             BWAPI::Position &defendPosition, const BWEB::Station *&defendStation); // after findDefendPosition()
+    std::optional<int> groundDefensesFor(const BWEB::Wall *);    // Walls.cpp updateDefenses(wall) -> needGroundDefenses(wall)
+    std::optional<int> airDefensesFor(const BWEB::Wall *);       // Walls.cpp updateDefenses(wall) -> needAirDefenses(wall)
+    std::optional<int> groundDefensesFor(const BWEB::Station *); // Stations.cpp needGroundDefenses(station)
+    std::optional<int> airDefensesFor(const BWEB::Station *);    // Stations.cpp needAirDefenses(station)
+} // namespace McRave::Sidecar
